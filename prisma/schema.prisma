datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Turma {
  id           Int        @id @default(autoincrement())
  ano          Int
  disciplinaId Int
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id])
}

model Docente {
  id           Int        @id @default(autoincrement())
  nome         String
  disciplinaId Int
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id])
}

model Disciplina {
  id           Int       @id @default(autoincrement())
  nome         String
  cargaHoraria Int
  semestre     Int
  curso        String
  Turma        Turma[]
  Docente      Docente[]
}
